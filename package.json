{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Live2D desktop pet extracted from metersphere-control-panel",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "smoke:mac": "cross-env DESKTOP_PET_SMOKE=1 electron . --smoke",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "package:mac:dir": "electron-builder --mac dir --publish never",
    "package:mac": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.sdwurg.desktop-pet",
    "productName": "Desktop Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
